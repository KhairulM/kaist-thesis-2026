@misc{xingContinualRobotPolicy2026,
  title = {Continual {{Robot Policy Learning}} via {{Variational Neural Dynamics}}},
  author = {Xing, Jiaxu and Zhu, Zhiyuan and Ren, Yunfan and Geles, Ismail and Zhai, Yifan and Reiter, Rudolf and Scaramuzza, Davide},
